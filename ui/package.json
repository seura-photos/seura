{
  "name": "seura-photos-ui",
  "private": true,
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.21 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "bindings": "node scripts/bindings.mjs",
    "shaders": "node scripts/shaders.mjs",
    "licenses": "node scripts/licenses.mjs",
    "icons": "node scripts/icons.mjs",
    "tokens": "node scripts/tokens.mjs",
    "tauri": "cd .. && tauri"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/api": "2.12.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
