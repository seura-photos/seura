# Environment and secrets
.env
.env.*
!.env.example

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Local test libraries (large photo sets used for benchmarks)
/test-libraries/

# Python bytecode (scripts/app_data_audit.py)
__pycache__/
