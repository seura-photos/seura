# Normalize line endings so Windows and macOS checkouts are identical.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.heic binary
*.heif binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.bin binary
