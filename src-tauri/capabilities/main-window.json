{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window's UI may call: Seura's own commands only. No file system, shell, or other plugins (decision 0009; technical design, section 10).",
  "windows": ["main"],
  "platforms": ["windows", "macOS"],
  "permissions": [
    "allow-app-version",
    "allow-open-link",
    "allow-add-folder",
    "allow-folders",
    "allow-remove-folder",
    "allow-photos",
    "allow-view-settings",
    "allow-set-sort",
    "allow-set-thumbnail-size",
    "allow-set-sidebar-width",
    "allow-show-thumbnails",
    "allow-change-photos",
    "allow-enhancing",
    "allow-enhance-downloading",
    "allow-stop-downloads",
    "allow-start-over",
    "allow-deleting",
    "allow-delete-photos",
    "allow-photo-notices",
    "allow-show-kept-files",
    "allow-tag-choices",
    "allow-tags",
    "allow-tag-photos",
    "allow-search-photos",
    "allow-undo",
    "allow-redo",
    "allow-show-in-folder",
    "allow-open-in-default-app",
    "allow-opening",
    "allow-photos-chosen",
    "allow-photo-details",
    "allow-selection-summary",
    "allow-open-photo",
    "allow-close-photo",
    "allow-editor-region",
    "allow-crop-aspect",
    "allow-view-photo",
    "allow-view-region",
    "allow-close-viewer",
    "allow-edit-photo",
    "allow-step-edit",
    "allow-revert-photo",
    "allow-resolve-outside-change",
    "allow-export-start",
    "allow-choose-export-folder",
    "allow-copy-edits",
    "allow-copied-edits",
    "allow-paste-edits",
    "allow-presets",
    "allow-preset-source",
    "allow-save-preset",
    "allow-rename-preset",
    "allow-delete-preset",
    "allow-apply-preset",
    "allow-preset-preview",
    "allow-export-photos",
    "allow-stop-export",
    "allow-show-exported",
    "allow-dev-options",
    "allow-text-scale",
    "allow-region",
    "allow-welcome",
    "allow-welcome-add-folder",
    "allow-welcome-choose-cache",
    "allow-finish-welcome",
    "allow-check-render",
    "allow-finish-render-check",
    "allow-finish-quit",
    "allow-measure-elapsed",
    "allow-scan-progress",
    "allow-measure-report",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
