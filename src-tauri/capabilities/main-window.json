{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window's UI may call: Seura's own commands only. No file system, shell, or other plugins (decision 0009; technical design, section 10).",
  "windows": ["main"],
  "platforms": ["windows", "macOS"],
  "permissions": [
    "allow-app-version",
    "allow-add-folder",
    "allow-folders",
    "allow-photos",
    "allow-show-thumbnails",
    "allow-open-photo",
    "allow-close-photo",
    "allow-set-exposure",
    "allow-export-photo",
    "allow-dev-options",
    "allow-text-scale",
    "allow-region",
    "allow-check-render",
    "allow-finish-render-check",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
