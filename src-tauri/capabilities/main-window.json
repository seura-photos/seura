{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main window's UI may call: Seura's own commands only. No file system, shell, or other plugins (decision 0009; technical design, section 10).",
  "windows": ["main"],
  "platforms": ["windows", "macOS"],
  "permissions": [
    "allow-app-version",
    "allow-add-folder",
    "allow-folders",
    "allow-remove-folder",
    "allow-photos",
    "allow-view-settings",
    "allow-set-sort",
    "allow-set-thumbnail-size",
    "allow-show-thumbnails",
    "allow-change-photos",
    "allow-tag-choices",
    "allow-tags",
    "allow-tag-photos",
    "allow-search-photos",
    "allow-undo",
    "allow-redo",
    "allow-show-in-folder",
    "allow-open-in-default-app",
    "allow-opening",
    "allow-photos-chosen",
    "allow-photo-details",
    "allow-selection-summary",
    "allow-open-photo",
    "allow-close-photo",
    "allow-view-photo",
    "allow-view-region",
    "allow-close-viewer",
    "allow-set-exposure",
    "allow-export-photo",
    "allow-dev-options",
    "allow-text-scale",
    "allow-region",
    "allow-welcome",
    "allow-welcome-add-folder",
    "allow-welcome-choose-cache",
    "allow-finish-welcome",
    "allow-check-render",
    "allow-finish-render-check",
    "allow-measure-elapsed",
    "allow-scan-progress",
    "allow-measure-report",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
