{
  "$description": "Seura Photos color tokens. Source of truth for the app's CSS variables and the website. See docs/visual-design.md.",
  "color": {
    "light": {
      "photo": "#F7F7F7",
      "panel": "#F0F0F0",
      "surface": "#FFFFFF",
      "border": "#D6D6D6",
      "text": "#1B1B1B",
      "textSecondary": "#5E5E5E",
      "accent": "#3352CC",
      "accentText": "#3352CC",
      "accentSubtle": "#E3E8FA",
      "onAccent": "#FFFFFF",
      "danger": "#B3261E",
      "dangerSubtle": "#FBE9E7",
      "rating": "#9A6700",
      "ratingOff": "#C9C9C9"
    },
    "dark": {
      "photo": "#1A1A1A",
      "panel": "#222222",
      "surface": "#2E2E2E",
      "border": "#3A3A3A",
      "text": "#ECECEC",
      "textSecondary": "#A0A0A0",
      "accent": "#3D5BE0",
      "accentText": "#8EA6FF",
      "accentSubtle": "#26304F",
      "onAccent": "#FFFFFF",
      "danger": "#FF8A80",
      "dangerSubtle": "#4A2523",
      "rating": "#E3B341",
      "ratingOff": "#4D4D4D"
    },
    "brand": {
      "blue": "#3352CC",
      "sky": "#7FA3E8",
      "green": "#3E9A6A",
      "gold": "#E9B949",
      "orange": "#E8823A",
      "rose": "#D9606A"
    },
    "overlay": {
      "onPhoto": "rgba(20,20,20,0.62)",
      "ratingOnPhoto": "#E3B341",
      "toolbarOnPhoto": "rgba(20,20,20,0.78)"
    }
  },
  "font": {
    "app": "-apple-system, BlinkMacSystemFont, 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif",
    "brand": "Figtree, system-ui, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Consolas, monospace"
  },
  "type": {
    "viewTitle": {
      "size": 17,
      "weight": 600
    },
    "panelHeading": {
      "size": 13,
      "weight": 600
    },
    "body": {
      "size": 13,
      "weight": 400
    },
    "meta": {
      "size": 12,
      "weight": 400
    },
    "sectionLabel": {
      "size": 11,
      "weight": 600,
      "letterSpacing": "0.06em",
      "transform": "uppercase"
    }
  },
  "radius": {
    "control": 6,
    "panel": 8,
    "chip": 13,
    "thumbnail": 3
  },
  "size": {
    "tier1Target": 32,
    "primaryTarget": 44,
    "header": 52,
    "footer": 28,
    "sidebar": 232,
    "infoPanel": 280,
    "editPanel": 300
  },
  "icon": {
    "grid": 24,
    "stroke": 1.75,
    "library": "Lucide (ISC license)"
  }
}
